# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.
# Vercel needs the same variables: Settings -> Environment Variables (Production + Preview).

# --- OpenAI: transcription + analysis (Phase 2-3) ---
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-5.5

# --- Supabase: database, audio storage, sign-in (Phase 1b) ---
# Supabase dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): Project Settings -> API Keys -> Secret keys. Server only.
SUPABASE_SECRET_KEY=

# --- App ---
# Locally http://localhost:3000; on Vercel, your Vercel URL (https://...)
APP_URL=http://localhost:3000
# Encrypts Google tokens at rest. Generated; use the SAME value on Vercel.
TOKEN_ENCRYPTION_KEY=

# --- Google Calendar (Phase 4, tomorrow) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
